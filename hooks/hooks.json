{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^(run_shell_command)$",
        "hooks": [
          { "type": "command", "command": "bun \"${extensionPath}/src/cli.ts\" pre --harness gemini", "timeout": 30000 }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command|read_file|write_file|replace|glob|search_file_content",
        "hooks": [
          { "type": "command", "command": "bun \"${extensionPath}/src/cli.ts\" post --harness gemini", "timeout": 30000 }
        ]
      }
    ]
  }
}
