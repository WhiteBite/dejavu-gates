{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash)$",
        "hooks": [
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/cli.ts\" pre --harness claude", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/cli.ts\" post --harness claude", "timeout": 30 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/cli.ts\" post --harness claude", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/cli.ts\" session-event --harness claude", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/src/cli.ts\" session-start --harness claude", "timeout": 30 }
        ]
      }
    ]
  }
}
