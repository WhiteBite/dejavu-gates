{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash)$",
        "hooks": [
          { "type": "command", "command": "{{CLI}} pre --harness codex", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          { "type": "command", "command": "{{CLI}} post --harness codex", "timeout": 30 }
        ]
      }
    ]
  }
}
