{
  "name": "dejavu-gates",
  "version": "2.39.0",
  "description": "Cross-session error gates for AI coding agents: detects recurring tool-call failures and promotes them into enforced gates. Remind first, block on same-session repeat offense. Works with OpenCode, Claude Code, Codex CLI, Gemini CLI, Cursor, Copilot CLI, and Crush.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src",
    "scripts",
    "command",
    "skills",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "copilot-cli",
    "crush",
    "ai-agents",
    "coding-agent",
    "error-gates",
    "hooks",
    "memory",
    "reliability",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WhiteBite/dejavu-gates.git"
  },
  "homepage": "https://github.com/WhiteBite/dejavu-gates",
  "bugs": "https://github.com/WhiteBite/dejavu-gates/issues",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test/smoke.ts",
    "lint:ast": "ast-grep scan"
  },
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  }
